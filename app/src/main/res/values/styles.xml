<resources>
    <style name="RegistrationLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/registration_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="RegistrationInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/registration_input_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/registration_text</item>
        <item name="android:textColorHint">@color/registration_hint</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="RegistrationGenderOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:buttonTint">@color/registration_purple</item>
        <item name="android:textColor">@color/registration_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
